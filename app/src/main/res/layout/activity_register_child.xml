<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvRegChildTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register a Child Account"
        android:textSize="22sp"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etChildUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Child's username"
        android:inputType="text" />

    <EditText
        android:id="@+id/etChildPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Child's password"
        android:inputType="textPassword"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etMonthlyAllowance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Monthly allowance"
        android:inputType="numberDecimal"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etMinSpend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Minimum monthly spend"
        android:inputType="numberDecimal"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etMaxSpend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Maximum monthly spend"
        android:inputType="numberDecimal"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etCategoryName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter a savings category"
        android:inputType="text"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnAddCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add Category"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvCategoriesAdded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnRegisterChild"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Register Child"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvRegChildError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D32F2F"
        android:layout_marginTop="12dp" />

</LinearLayout>
