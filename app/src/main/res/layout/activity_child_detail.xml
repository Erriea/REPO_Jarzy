<?xml version="1.0" encoding="utf-8"?>
<!-- Restyled around three tabs (Stats / Categories / History) instead of one long
     scrolling form, inspired by the reference image the user provided - a top toggle
     switches between views, and the categories are shown as swipeable coloured cards
     instead of a plain dropdown. Every view the Kotlin code looks up by id keeps that
     exact id and behaviour; spinnerCategories is the one exception - it's been replaced
     by vpCategories (a ViewPager2) since the whole point here is to swipe between
     categories instead of picking one from a dropdown list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jarzy_blue">

    <include layout="@layout/toolbar_jarzy_brand" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <Button
                android:id="@+id/btnBack"
                android:fontFamily="@font/comic_relief_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textSize="16sp"
                android:textColor="@color/jarzy_blue"
                app:backgroundTint="@color/white" />

            <TextView
                android:id="@+id/tvChildDetailHeading"
                android:fontFamily="@font/comic_relief_bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvParentViewLabel"
                android:fontFamily="@font/comic_relief_regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(Parent View)"
                android:textStyle="italic"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <!-- The three-way toggle - selectTab() in ChildDetailActivity.kt shows and
                 hides the matching content block below and restyles these three buttons
                 (filled white for whichever is selected, outlined for the other two). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/btnTabStats"
                    android:fontFamily="@font/comic_relief_bold"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stats"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:insetLeft="2dp"
                    android:insetRight="2dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="2dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnTabCategories"
                    android:fontFamily="@font/comic_relief_bold"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Categories"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:insetLeft="2dp"
                    android:insetRight="2dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="2dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnTabHistory"
                    android:fontFamily="@font/comic_relief_bold"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="History"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:insetLeft="2dp"
                    android:insetRight="2dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="2dp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- ===================== STATS TAB ===================== -->
            <LinearLayout
                android:id="@+id/llStatsTabContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <!-- Balance shown as one big white "cube" - the child's total across
                     every category, the same figure the old plain text version showed. -->
                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/shape_cube_balance">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:fontFamily="@font/comic_relief_regular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Balance"
                            android:textSize="18sp"
                            android:textColor="@color/jarzy_blue" />

                        <TextView
                            android:id="@+id/tvSavingsTotal"
                            android:fontFamily="@font/comic_relief_bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="34sp"
                            android:textColor="@color/jarzy_blue"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/tvAllowanceDisplay"
                    android:fontFamily="@font/comic_relief_regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvSpendRange"
                    android:fontFamily="@font/comic_relief_regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

                <EditText
                    android:id="@+id/etAddBalanceAmount"
                    android:fontFamily="@font/comic_relief_regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount to add"
                    android:inputType="numberDecimal"
                    android:background="@drawable/shape_input_field_white"
                    android:textColorHint="#777777"
                    android:textSize="16sp"
                    android:padding="14dp"
                    android:layout_marginTop="20dp" />

                <Button
                    android:id="@+id/btnAddToBalance"
                    android:fontFamily="@font/comic_relief_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add to Balance"
                    android:textSize="16sp"
                    android:textColor="@color/jarzy_blue"
                    app:backgroundTint="@color/white"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btnToggleEditProfile"
                    android:fontFamily="@font/comic_relief_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit Child Profile"
                    android:textSize="16sp"
                    android:textColor="@color/jarzy_blue"
                    app:backgroundTint="@color/white"
                    android:layout_marginTop="10dp" />

                <!-- Collapsed by default (android:visibility="gone") - btnToggleEditProfile
                     above shows/hides this whole block instead of it always being on screen. -->
                <LinearLayout
                    android:id="@+id/llEditAccountFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:fontFamily="@font/comic_relief_bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Edit Child Account"
                        android:textColor="@color/white"
                        android:layout_marginTop="20dp" />

                    <!-- Each field below is pre-filled with setText() as soon as this screen
                         loads (ChildDetailActivity.refreshAll()) - the android:hint text only
                         shows on an EMPTY EditText, so once a value is filled in the hint is
                         invisible and there'd be no way to tell the fields apart. A plain
                         label above each one fixes that regardless of what's typed in it. -->
                    <TextView
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textColor="@color/white"
                        android:layout_marginTop="14dp" />

                    <EditText
                        android:id="@+id/etEditUsername"
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Username"
                        android:inputType="text"
                        android:background="@drawable/shape_input_field_white"
                        android:textColorHint="#777777"
                        android:padding="12dp" />

                    <TextView
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textColor="@color/white"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/etEditPassword"
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:background="@drawable/shape_input_field_white"
                        android:textColorHint="#777777"
                        android:padding="12dp" />

                    <TextView
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Monthly Allowance"
                        android:textColor="@color/white"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/etEditAllowance"
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Monthly allowance"
                        android:inputType="numberDecimal"
                        android:background="@drawable/shape_input_field_white"
                        android:textColorHint="#777777"
                        android:padding="12dp" />

                    <TextView
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Minimum Monthly Spend"
                        android:textColor="@color/white"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/etEditMinSpend"
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Minimum monthly spend"
                        android:inputType="numberDecimal"
                        android:background="@drawable/shape_input_field_white"
                        android:textColorHint="#777777"
                        android:padding="12dp" />

                    <TextView
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Maximum Monthly Spend"
                        android:textColor="@color/white"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/etEditMaxSpend"
                        android:fontFamily="@font/comic_relief_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Maximum monthly spend"
                        android:inputType="numberDecimal"
                        android:background="@drawable/shape_input_field_white"
                        android:textColorHint="#777777"
                        android:padding="12dp" />

                    <Button
                        android:id="@+id/btnSaveAccountChanges"
                        android:fontFamily="@font/comic_relief_bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Changes"
                        android:textSize="16sp"
                        android:textColor="@color/jarzy_blue"
                        app:backgroundTint="@color/white"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tvAccountEditError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D32F2F"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ===================== CATEGORIES TAB ===================== -->
            <LinearLayout
                android:id="@+id/llCategoriesTabContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <!-- Swipe left/right to bring a different category's cube to the front -
                     Edit Category and Delete Category below act on whichever cube is
                     currently centred (ChildDetailActivity reads vpCategories.currentItem). -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpCategories"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:clipToPadding="false"
                    android:clipChildren="false" />

                <Button
                    android:id="@+id/btnEditCategory"
                    android:fontFamily="@font/comic_relief_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit Category"
                    android:textSize="16sp"
                    android:textColor="@color/jarzy_blue"
                    app:backgroundTint="@color/white"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/btnSaveCategory"
                    android:fontFamily="@font/comic_relief_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add New Category"
                    android:textSize="16sp"
                    android:textColor="@color/jarzy_blue"
                    app:backgroundTint="@color/white"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btnDeleteCategory"
                    android:fontFamily="@font/comic_relief_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Delete Category"
                    android:textSize="16sp"
                    android:textColor="@color/jarzy_blue"
                    app:backgroundTint="@color/white"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <!-- ===================== HISTORY TAB ===================== -->
            <LinearLayout
                android:id="@+id/llHistoryTabContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <TextView
                    android:fontFamily="@font/comic_relief_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category Totals"
                    android:textSize="18sp"
                    android:textColor="@color/white" />

                <!-- Quick totals reusing the same category data already loaded for this
                     screen - the full entry-by-entry history (with photos and date
                     filtering) stays its own dedicated screen rather than being rebuilt
                     inline here, so View Full Expense History below opens that. -->
                <TextView
                    android:id="@+id/tvSavingsBreakdown"
                    android:fontFamily="@font/comic_relief_regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnViewExpenseHistory"
                    android:fontFamily="@font/comic_relief_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Full Expense History"
                    android:textSize="16sp"
                    android:textColor="@color/jarzy_blue"
                    app:backgroundTint="@color/white"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
